// WOPR Model Registry + Gameplay Capture (clean DBML)

Table model_families {
  id int [pk, increment]
  uuid uuid [unique, not null]
  name varchar(255) [unique, not null]
  shortname varchar(32) [unique, not null]
  description text [null]
  note text [null]
  url varchar(200) [null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  mf_status jsonb [not null]

  indexes {
    uuid
    name
    shortname
    created_at
    updated_at
  }
}

Table model_info {
  id int [pk, increment]
  uuid uuid [unique, not null]
  name varchar(255) [unique, not null]
  shortname varchar(32) [unique, not null]
  description text [null]
  note text [null]
  family_id int [not null, ref: > model_families.id]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    uuid
    name
    shortname
    created_at
    updated_at
    family_id
  }
}

Table model_version {
  id int [pk, increment]
  uuid uuid [unique, not null]
  version int [not null]
  artifact_uri varchar(1024) [not null]
  checksum varchar(128) [null]
  description text [null]
  note text [null]
  trained_at timestamp [null]
  is_current boolean [not null, default: false]
  model_id int [not null, ref: > model_info.id]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    uuid
    version
    is_current
    created_at
    updated_at
    model_id
  }
}

Table model_backup {
  id int [pk, increment]
  uuid uuid [unique, not null]
  taken_at timestamp [not null]
  was_successful boolean [not null, default: false]
  artifact_uri varchar(1024) [unique, not null]
  model_version_id int [not null, ref: > model_version.id]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  note text [null]

  indexes {
    uuid
    taken_at
    was_successful
    created_at
    updated_at
    model_version_id
  }
}

Table datasets {
  id int [pk, increment]
  uuid uuid [unique, not null]
  artifact_uri varchar(1024) [not null]
  description text [null]
  note text [null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  project_id int [null]

  indexes {
    uuid
    created_at
    updated_at
  }
}

Table results {
  id int [pk, increment]
  uuid uuid [unique, not null]
  accuracy float [null]
  loss float [null]
  description text [null]
  note text [null]
  artifact_uri varchar(1024) [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    uuid
    created_at
    updated_at
  }
}

Table training_run {
  id int [pk, increment]
  uuid uuid [unique, not null]
  description text [null]
  note text [null]
  training_parameters jsonb [not null]
  dataset_id int [not null, ref: > datasets.id]
  result_id int [null, ref: > results.id]
  model_version_id int [not null, ref: > model_version.id]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  run_timestamp timestamp [null]

  indexes {
    uuid
    dataset_id
    result_id
    model_version_id
    created_at
    updated_at
    run_timestamp
  }
}

/* ---------------------------
   Gameplay capture additions
   --------------------------- */

Table game {
  id int [pk, increment]
  uuid uuid [unique, not null]
  short_id varchar(5) [unique, not null] // first 5 of uuid (store it, don't compute in SQL)
  name varchar(255) [unique, not null]
  shortname varchar(64) [unique, not null]
  min_players int [not null]
  max_players int [not null] // you had "man_players"

  description text [null]
  note text [null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    uuid
    short_id
    created_at
    updated_at
    name
    shortname
  }
}

Table player {
  id int [pk, increment]
  uuid uuid [unique, not null]
  short_id varchar(5) [unique, not null] // first 5 of uuid
  irl_name varchar(255) [unique, not null]
  handle varchar(64) [unique, not null]

  description text [null]
  note text [null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    uuid
    short_id
    created_at
    updated_at
    irl_name
    handle
  }
}

Table session {
  id int [pk, increment]
  uuid uuid [unique, not null]
  short_id varchar(5) [unique, not null] // first 5 of uuid
  description text [null]
  note text [null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  game_id int [not null, ref: > game.id]

  indexes {
    uuid
    short_id
    created_at
    updated_at
    game_id
  }
}

/*
  IMPORTANT: "player_list" should NOT be a list-of-ids column if you want
  sane querying + integrity. Use a join table.
*/
Table session_players {
  session_id int [not null, ref: > session.id]
  player_id int [not null, ref: > player.id]
  seat int [null] // optional: turn order / seat position

  indexes {
    session_id
    player_id
  }

  Note: 'Composite PK recommended: (session_id, player_id)'
}

Table image {
  id int [pk, increment]
  uuid uuid [unique, not null]
  short_id varchar(5) [unique, not null] // first 5 of uuid
  artifact_uri varchar(1024) [unique, not null]

  description text [null]
  note text [null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    uuid
    short_id
    created_at
    updated_at
    artifact_uri
  }
}

Table move {
  id int [pk, increment]
  uuid uuid [unique, not null]
  short_id varchar(5) [unique, not null] // first 5 of uuid
  description text [null]
  note text [null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  session_id int [not null, ref: > session.id]
  player_id int [not null, ref: > player.id]

  previous_move_id int [null, ref: > move.id] // linked list
  image_at_end_id int [null, ref: > image.id]  // snapshot after move

  indexes {
    uuid
    short_id
    created_at
    updated_at
    session_id
    player_id
    previous_move_id
    image_at_end_id
  }
}
