// WOPR Model Registry Schema v0.1.6-alpha
// Generated from Django models

Table model_families {
  id int [pk, increment]
  uuid uuid [unique, not null]
  name varchar(255) [unique, not null]
  shortname varchar(32) [unique, not null]
  description text [null]
  note text [null]
  url varchar [null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  mf_status jsonb [null]
  
  indexes {
    uuid
    name
    shortname
    created_at
    updated_at
  }
}

Table model_info {
  id int [pk, increment]
  uuid uuid [unique, not null]
  name varchar(255) [unique, not null]
  shortname varchar(32) [unique, not null]
  description text [null]
  note text [null]
  family_id int [not null, ref: > model_families.id]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  
  indexes {
    uuid
    name
    shortname
    created_at
    updated_at
    family_id
  }
}

Table model_version {
  id int [pk, increment]
  uuid uuid [unique, not null]
  version int [not null]
  artifact_uri varchar(1024) [not null]
  checksum varchar(128) [null]
  description text [null]
  note text [null]
  trained_at timestamp [null]
  is_current boolean [not null, default: false]
  model_id int [not null, ref: > model_info.id]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  
  indexes {
    uuid
    version
    is_current
    created_at
    updated_at
    model_id
  }
  
  Note: 'Needs constraint: only one is_current=true per model_id'
}

Table model_backup {
  id int [pk, increment]
  uuid uuid [unique, not null]
  taken_at timestamp [not null]
  was_successful boolean [not null, default: false]
  artifact_uri varchar(1024) [unique, not null]
  model_version_id int [not null, ref: > model_version.id]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  note text [null]
  
  indexes {
    uuid
    taken_at
    was_successful
    created_at
    updated_at
    model_version_id
  }
}

Table training_run {
  id int [pk, increment]
  uuid uuid [unique, not null]
  description text [null]
  note text [null]
  training_parameters jsonb [null]
  dataset_id int [not null, ref: > datasets.id]
  result_id int [null, ref: > results.id]
  model_version_id int [not null, ref: > model_version.id]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  run_timestamp timestamp [null]
  
  indexes {
    uuid
    dataset_id
    result_id
    model_version_id
    created_at
    updated_at
    run_timestamp
  }
}

Table datasets {
  id int [pk, increment]
  uuid uuid [unique, not null]
  artifact_uri varchar(1024) [unique, not null]
  description text [null]
  note text [null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  
  indexes {
    uuid
    created_at
    updated_at
  }
}

Table results {
  id int [pk, increment]
  uuid uuid [unique, not null]
  accuracy float [null]
  loss float [null]
  description text [null]
  note text [null]
  artifact_uri varchar(1024) [unique, not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  
  indexes {
    uuid
    created_at
    updated_at
  }
}

// Relationships
// ModelFamily (1) --< ModelInfo (N)
// ModelInfo (1) --< ModelVersion (N)
// ModelVersion (1) --< ModelBackup (N)
// ModelVersion (1) --< TrainingRun (N)
// Dataset (1) --< TrainingRun (N)
// Result (1) <-- TrainingRun (1)