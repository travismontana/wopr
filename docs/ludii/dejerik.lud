/*
 * Important Notes apparently.
 * When your piece attacks your opponent’s piece, your piece will move to occupy that location. Once in that location if another opponent’s piece is on a subsequent attack tile then you can take that piece too, chaining the attacks together.
 * ^ ^ ^ ^ ^
 * that means chainable attackes, e.g. SequenceCapture
 */

/*
 * MOVE: 1 tile forward, backward, left, right, or diagonally. When moving backward on the outer circle this piece can move as if it was going off the board to the other side.
 * ATTACK: 1 tile forward, left, right, or diagonally. Cannot attack pieces that have not moved from their starting position.
 */
(define "BruteMoves"
  { // Todos
    // Can not attack pieces who havnt moved yet
    (move
      (step (to (sites Empty))
      (directions {In Out CW CCW {In CW} {In CCW} {Out CW} {Out CCW}} ))
    )
    (move    
      (leap (from (sites Outer))
        {{CCW CCW CCW CCW CCW CCW}}
        (to (sites Empty))
      )
    )
    (capture (step (to (sites Occupied by:Next))  (directions {In Out CW CCW {In CW} {In CCW} {Out CW} {Out CCW}})))
  }
)

/*
 * MOVE: 2 tiles to the left or 2 tiles to the right. This piece can hop over other pieces. 1 tile forward or backward.
 * ATTACK: 1 tile forward or backward then 2 tiles to the right or the left (an L-shaped move).
 */
(define "PredatorMoves"
  {
    (move (leap {{CW CW} {CCW CCW}} (to (sites Empty))))
    (move (step (to (sites Empty)) (directions {In Out})))
    (capture (leap {{In CW CW} {In CCW CCW} {Out CW CW} {Out CCW CCW}} (to (sites Occupied by:Next)))    )
  }
)

/*
 * MOVE: 1 tile forward or backward 2 tiles to the right or the left (an L-shaped move).
 * ATTACK: 2 tiles to the right or the left.
 */
(define "GuardianMoves"
  {
    (move
      (leap {{In CW CW} {In CCW CCW} {Out CW CW} {Out CCW CCW}} (to (sites Empty)))
    )
    (capture
      (leap {{CW CW} {CCW CCW}} (to (sites Occupied by:Next)))
    )
  }
)

/*
 * MOVE: 2 tiles in any direction. This piece can move off the start point and back again.
 * reading this as 2 tiles, 2 cw/ccw, or 1 cw/ccw && 1 in/out
 * ATTACK: 1 square forward or backward. Can attack before or after moving, but can only attack once.
 */
(define "ScoutMoves"
  {
    (move 
      (leap {{In CW} {Out CW} {In CCW} {Out CCW} {CW CW} {CCW CCW}} (to (sites Empty)))
      (then
        (if (= (var "scoutMoved") 0)
          (do
            (set Var "scoutMoved" 1)
            (moveAgain)
          )
        )
      )
    )
    (capture (step (to (sites Occupied by:Next)) (directions {In Out})))
  }
)

(game "Dejarik"
  (players 2)
  (equipment {
    (board (concentric {12 12} stagger:false))

    (piece "Mantellian Savrip" P1 (moves "BruteMoves"))
    (piece "Kintan Strider" P2 (moves "BruteMoves"))

    (piece "K'lor'slug" P1 (moves "PredatorMoves"))
    (piece "Ng'ok" P2 (moves "PredatorMoves"))

    (piece "Molator" P1 (moves "GuardianMoves"))
    (piece "Monnok" P2 (moves "GuardianMoves"))

    (piece "Ghhhk" P1 (moves "ScoutMoves"))
    (piece "Houjix" P2 (moves "ScoutMoves"))
  })

  (rules
    (start {
        (place "Ng'ok" (site 0))
        (place "Monnok" (site 11))
        (place "Houjix" (site 12))
        (place "Kintan Strider" (site 23))
        (place "K'lor'slug" (site 6))
        (place "Ghhhk" (site 5))
        (place "Molator" (site 18))
        (place "Mantellian Savrip" (site 17))
    })

    (play (move))  ; uses each piece’s (moves ...) definitions

    (end (if (no Pieces Next) (result Mover Win)))
  )
)